<view class="{{ready && pageVisible ? 'page-enter' : ''}} page budget-page">
  <view wx:if="{{syncEnabled}}" class="shared-sync-bar"><text class="{{syncError ? 'overdue' : ''}}">{{syncError || '共同计划 · 最近同步 ' + syncedAt}}</text><button class="text-link" bindtap="refresh" disabled="{{loading}}">刷新</button></view>
  <view class="page-heading enter-block">
    <view class="page-heading-copy"><view class="eyebrow">ROOM FOR EVERY WISH</view><view class="page-title title-row">心意，也有计划</view><view class="subtitle">花得明白，才能更安心地期待。</view></view>
    <image class="page-heading-illustration" src="/assets/illustrations/wallet.png" mode="aspectFit" />
  </view>
  <view wx:if="{{loading}}" class="loading-line">正在整理预算…</view>
  <view wx:if="{{errorMessage}}" class="pressable notice error-notice" bindtap="refresh" hover-class="is-pressed" hover-start-time="20" hover-stay-time="100">{{errorMessage}} · 点此重试</view>
  <block wx:if="{{ready}}">
    <view class="enter-block enter-last budget-hero section">
      <view class="between"><text class="budget-label">婚礼总预算</text><button class="pressable budget-edit" bindtap="setBudget" hover-class="is-pressed" hover-start-time="20" hover-stay-time="100">调整 ›</button></view>
      <view wx:if="{{profile.totalBudget}}" class="budget-total"><text>¥</text>{{stats.budgetText}}</view>
      <button wx:else class="pressable budget-unset" bindtap="setBudget" hover-class="is-pressed" hover-start-time="20" hover-stay-time="100">一起定个小目标 ↗</button>
      <view class="budget-divider"></view>
      <view class="money-grid"><view><view class="money-label">预计开支</view><view class="money-value">¥{{stats.plannedText}}</view></view><view><view class="money-label">已经支付</view><view class="money-value">¥{{stats.paidText}}</view></view></view>
      <view wx:if="{{profile.totalBudget}}" class="budget-remaining">{{paidOverBudget ? '已付超出预算' : '预算尚余'}} <text>¥{{stats.remainingText}}</text><text class="budget-small">（按已付计算）</text></view>
    </view>
    <view wx:if="{{stats.overBudget}}" class="notice over-notice">预计开支已超过总预算。可以一起看看哪些心意最值得保留，或调整总预算。</view>
    <view wx:if="{{breakdown.length}}" class="enter-block enter-last section card breakdown">
      <view class="between"><text class="section-title">预算花在哪里</text><text class="breakdown-label">按预计开支</text></view>
      <view class="stacked-bar"><view wx:for="{{breakdown}}" wx:key="name" class="bar-segment" style="width: {{item.percent}}%; background: {{item.color}};"></view></view>
      <view class="legend"><view wx:for="{{breakdown}}" wx:key="name" class="legend-item"><view class="row"><view class="legend-dot" style="background: {{item.color}};"></view><text>{{item.name}}</text></view><text>¥{{item.amount}}</text></view></view>
    </view>
    <view class="enter-block enter-last section"><view class="between section-head"><text class="section-title">每一笔心意</text><button class="pressable text-link" bindtap="openAdd" hover-class="is-pressed" hover-start-time="20" hover-stay-time="100">＋ 记一笔</button></view>
      <picker range="{{taskFilterOptions}}" range-key="title" value="{{taskFilterIndex}}" bindchange="setTaskFilter"><view class="field-input between association-filter"><text>安排 · {{taskFilterOptions[taskFilterIndex].title}}</text><text>⌄</text></view></picker>
      <view wx:if="{{taskFilter}}" class="notice linked-summary"><view>这件安排共 {{selectedBudget.count}} 笔 · 预计 ¥{{selectedBudget.plannedText}} · 已付 ¥{{selectedBudget.paidText}}</view><button class="pressable linked-action" bindtap="clearTaskFilter" hover-class="is-pressed">查看全部安排 ›</button></view>
      <view wx:if="{{reminderCount}}" class="card payment-list linked-summary">
        <view class="section-title">付款提醒 · {{reminderCount}} 笔待付</view>
        <button wx:for="{{reminders}}" wx:key="id" class="pressable payment-row" data-id="{{item.id}}" bindtap="openEdit" hover-class="is-pressed"><view>{{item.title}} · 待付 ¥{{item.outstandingText}}</view><view class="reminder-meta {{item.paymentOverdue ? 'overdue' : ''}}">{{item.paymentDueDate}} · {{item.paymentLabel}} ›</view></button>
        <view class="field-hint">显示最近 3 笔；其他付款日期可在开支记录中查看。应用内提醒，付清后自动移出。</view>
      </view>
      <scroll-view wx:if="{{breakdown.length}}" scroll-x="{{true}}" class="expense-filters" show-scrollbar="{{false}}"><view class="expense-filter-inner"><button class="pressable expense-filter {{category === '全部' ? 'active' : ''}}" data-category="全部" bindtap="setCategory" hover-class="is-pressed" hover-start-time="20" hover-stay-time="100">全部</button><button wx:for="{{breakdown}}" wx:key="name" class="pressable expense-filter {{category === item.name ? 'active' : ''}}" data-category="{{item.name}}" bindtap="setCategory" hover-class="is-pressed" hover-start-time="20" hover-stay-time="100">{{item.name}}</button></view></scroll-view>
      <view wx:for="{{expenses}}" wx:key="id" class="pressable card expense-card" data-id="{{item.id}}" bindtap="openEdit" hover-class="is-pressed" hover-start-time="20" hover-stay-time="100">
        <view class="between"><image class="expense-illustration" src="{{item.illustration}}" mode="aspectFit" /><view class="expense-name">{{item.title}}</view><view class="expense-amount">¥{{item.plannedText}}</view></view>
        <view class="between expense-meta"><view class="row"><view class="legend-dot" style="background: {{item.color}};"></view><text>{{item.category}}</text></view><text class="{{item.exceeded ? 'overdue' : ''}}">已付 ¥{{item.paidText}}{{item.exceeded ? ' · 超预计' : ''}}</text></view>
        <view wx:if="{{item.note}}" class="expense-note">{{item.note}}</view>
        <button wx:if="{{item.taskId}}" class="pressable linked-action" data-id="{{item.taskId}}" catchtap="openTask" hover-class="is-pressed" hover-stop-propagation="{{true}}">关联安排 · {{item.taskTitle}} ›</button>
        <view wx:else class="field-hint">未关联安排 · 编辑可绑定</view>
        <view wx:if="{{item.paymentDueDate}}" class="reminder-meta {{item.paymentOverdue ? 'overdue' : ''}}">{{item.paymentDueDate}} · {{item.paymentLabel}}{{item.outstanding ? ' · 待付 ¥' + item.outstandingText : ''}}</view>
      </view>
      <view wx:if="{{!expenses.length}}" class="card empty"><image class="empty-illustration" src="/assets/illustrations/gift.png" mode="aspectFit" /><view class="empty-title">{{taskFilter ? '给这件安排记一笔预算' : '把第一份心意记在这里'}}</view><view class="empty-copy">预计花多少、已付多少，都心中有数。<view wx:if="{{taskFilter}}">新增开支会自动关联当前安排。</view></view><button class="pressable primary empty-button" bindtap="openAdd" hover-class="is-pressed" hover-start-time="20" hover-stay-time="100">＋ 添加一笔开支</button></view>
    </view>
    <view class="footer-note">用喜欢的方式，准备喜欢的婚礼。</view>
  </block>
</view>
<bottom-sheet visible="{{editor}}" busy="{{saving}}" title="{{editingId ? '这笔心意的详情' : '记一笔心意'}}" bindclose="closeEditor">
  <view class="field"><text class="field-label">开支名称</text><input class="field-input" maxlength="60" placeholder="比如：婚礼摄影团队" value="{{form.title}}" data-field="title" bindinput="field" /></view>
  <view class="field"><text class="field-label">关联安排</text><picker range="{{taskOptions}}" range-key="title" value="{{taskIndex}}" bindchange="chooseTask"><view class="field-input between"><text>{{taskOptions[taskIndex].title}}</text><text class="muted">⌄</text></view></picker><view class="field-hint">一件安排可以关联多笔开支；选择“暂不关联安排”可解除绑定。</view></view>
  <view class="field"><text class="field-label">分类</text><picker range="{{categories}}" value="{{categoryIndex}}" bindchange="chooseCategory"><view class="field-input between"><text>{{form.category}}</text><text class="muted">⌄</text></view></picker></view>
  <view class="form-row"><view class="field"><text class="field-label">预计总金额（元）</text><input class="field-input" type="digit" maxlength="12" placeholder="0.00" value="{{form.plannedInput}}" data-field="plannedInput" bindinput="field" /></view><view class="field"><text class="field-label">已付金额（元）</text><input class="field-input" type="digit" maxlength="12" placeholder="0.00" value="{{form.paidInput}}" data-field="paidInput" bindinput="field" /></view></view>
  <view class="field"><text class="field-label">备注</text><textarea class="field-input" maxlength="300" placeholder="套餐内容、尾款时间，或需要留意的细节…" value="{{form.note}}" data-field="note" bindinput="field" /></view>
  <view class="field"><view class="between"><text class="field-label">付款日期（可选）</text><button wx:if="{{form.paymentDueDate}}" class="text-link" bindtap="clearPaymentDate">清除日期</button></view><picker mode="date" start="2000-01-01" end="2100-12-31" value="{{form.paymentDueDate}}" bindchange="choosePaymentDate"><view class="field-input between"><text>{{form.paymentDueDate || '选择约定付款日期'}}</text><text class="muted">⌄</text></view></picker><view class="field-hint">未付清时在首页和预算页提醒，不会发送微信消息。分期付款可拆成定金、尾款两笔，分别填写各期金额和日期。</view></view>
  <view class="field-hint note-spacing">这里用于记账，不会发起支付。已付金额包含定金和后续付款。</view>
  <button class="pressable primary" bindtap="save" loading="{{saving}}" disabled="{{saving}}" hover-class="is-pressed" hover-start-time="20" hover-stay-time="100">保存这笔开支</button>
  <button wx:if="{{editingId}}" class="pressable danger-link" bindtap="remove" disabled="{{saving}}" hover-class="is-pressed" hover-start-time="20" hover-stay-time="100">删除这笔开支</button>
</bottom-sheet>
