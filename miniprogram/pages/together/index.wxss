.centered { text-align: center; margin-top: 10rpx; }
.couple-section { text-align: center; padding: 42rpx 0 36rpx; }
.avatars { display: flex; justify-content: center; align-items: center; }
.avatar { width: 118rpx; height: 118rpx; line-height: 114rpx; border-radius: 50%; font-size: 43rpx; border: 3rpx solid #fffdf8; }
.avatar-one { background: #dde5ce; color: #748958; }
.avatar-two { background: #ece1cc; color: #ad9062; }
.heart { font-size: 40rpx; color: #a8b28a; width: 65rpx; }
.couple-heading { font-size: 40rpx; margin-top: 22rpx; overflow-wrap: anywhere; }
.couple-heading text { font-family: Georgia, serif; font-style: italic; color: #a0a881; margin: 0 22rpx; }
.profile-card .section-head { margin-bottom: 6rpx; }
.profile-row { display: flex; justify-content: space-between; align-items: center; gap: 24rpx; padding: 25rpx 0; border-bottom: 1rpx solid #eef0e5; font-size: 25rpx; color: #96a087; }
.profile-row:last-child { border: 0; padding-bottom: 12rpx; }
.profile-row > text:first-child { flex-shrink: 0; }
.profile-value { text-align: right; color: #556c43; max-width: 370rpx; overflow-wrap: anywhere; }
.chevron { color: #a1ad8c; margin-left: 10rpx; }
.space-card { background: #f1f3e9; border-color: #e2e8d4; }
.space-copy { color: #879278; font-size: 25rpx; margin: 22rpx 0 28rpx; line-height: 1.9; }
.space-footnote { color: #959e86; text-align: center; font-size: 21rpx; margin-top: 17rpx; }
.unavailable[disabled] { background: #e4e9d9; color: #91a17d; }
.join-link { font-size: 24rpx; color: #7b8e63; margin: 24rpx 0 2rpx; }
.local-link { font-size: 21rpx; color: #97a185; margin-top: 25rpx; }
.bound-note { border: 1rpx solid #d9e1cb; border-radius: 14rpx; padding: 23rpx; text-align: center; color: #768b5c; }
.invite-box { margin-top: 20rpx; padding: 24rpx 16rpx; border: 1rpx dashed #bcc7a7; border-radius: 14rpx; text-align: center; }
.invite-code { letter-spacing: 4rpx; font-size: 34rpx; font-family: monospace; }
.tools-card { padding-top: 8rpx; padding-bottom: 8rpx; }
.tool-row { display: flex; justify-content: space-between; text-align: left; padding: 28rpx 0; font-size: 26rpx; border-bottom: 1rpx solid #ecefe3; }
.tool-row:last-child { border: 0; }
.tool-note { font-size: 21rpx; color: #9aa48b; margin-top: 7rpx; }
.code-input { font-family: monospace; letter-spacing: 4rpx; }
.join-notice { margin-bottom: 28rpx; }
.couple-section { background: #f5efe2; border: 1rpx solid #eae2d2; border-radius: 28rpx 28rpx 75rpx 28rpx; margin: 32rpx 0 36rpx; padding: 28rpx 28rpx 40rpx; }
.couple-illustration { display: block; width: 490rpx; height: 395rpx; margin: 0 auto; }
.couple-heading { font-family: Georgia, 'Songti SC', serif; margin-top: 0; }
.couple-section .subtitle { font-size: 22rpx; }
.gallery-caption { color: #a0a88e; font-size: 24rpx; line-height: 1.9; margin-bottom: 24rpx; }
.illustration-gallery { display: flex; flex-wrap: wrap; gap: 22rpx 10rpx; }
.gallery-item { width: calc((100% - 30rpx) / 4); text-align: center; font-size: 19rpx; color: #9ba588; }
.gallery-item image { display: block; width: 100%; height: 125rpx; margin: 0 auto 10rpx; }
