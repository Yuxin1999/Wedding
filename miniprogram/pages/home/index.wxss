.greeting { align-items: flex-end; margin: 4rpx 0 36rpx; }
.greeting > view { flex: 1; min-width: 0; }
.couple-name { font-size: 42rpx; font-weight: 500; margin-top: 10rpx; max-width: 440rpx; overflow-wrap: anywhere; }
.ampersand { font-family: Georgia, serif; font-style: italic; color: #9ca47a; padding: 0 10rpx; }
.sync-pill { flex-shrink: 0; display: flex; align-items: center; font-size: 20rpx; color: #899177; padding-bottom: 10rpx; }
.status-dot { width: 9rpx; height: 9rpx; border-radius: 50%; background: #91a075; margin-right: 9rpx; }
.hero { position: relative; overflow: hidden; background: #7e8e6b; color: #fffef5; border-radius: 28rpx; padding: 40rpx 36rpx 32rpx; }
.hero-top { color: #b7c1a6; letter-spacing: 4rpx; font-size: 18rpx; }
.countdown-label { margin-top: 35rpx; color: #d5dccb; font-size: 25rpx; }
.countdown { font-size: 108rpx; line-height: 1.2; font-family: Georgia, serif; letter-spacing: -3rpx; margin: 12rpx 0 24rpx; }
.day-unit { font-size: 25rpx; margin-left: 16rpx; color: #c1cbb4; font-family: sans-serif; }
.set-date { font-size: 50rpx; font-weight: 400; margin: 22rpx 0 36rpx; }
.set-date text { color: #cbd2ae; margin-left: 12rpx; }
.hero-bottom { display: flex; justify-content: space-between; position: relative; border-top: 1rpx solid rgba(210, 219, 191, .2); padding-top: 22rpx; color: #c4ceb8; font-size: 23rpx; }
.hero-edit { font-size: 21rpx; }
.hero-rings { position: absolute; right: 12rpx; top: 38rpx; width: 220rpx; height: 190rpx; opacity: .62; }
.ring { border: 2rpx solid #aab88a; width: 128rpx; height: 128rpx; border-radius: 50%; position: absolute; }
.ring-one { right: 66rpx; top: 58rpx; transform: rotate(-25deg); }
.ring-two { right: 9rpx; top: 40rpx; }
.spark { position: absolute; right: 36rpx; top: -16rpx; font-size: 62rpx; color: #d3dbb2; }
.stat-grid { display: flex; gap: 24rpx; margin-top: 28rpx; }
.stat-card { flex: 1; min-width: 0; padding: 28rpx; }
.stat-label { font-size: 24rpx; color: #778269; }
.tiny-arrow { color: #a0aa8b; }
.stat-number { font-family: Georgia, serif; font-size: 62rpx; line-height: 1; margin: 26rpx 0 22rpx; }
.stat-number text { font-family: sans-serif; font-size: 24rpx; color: #9aa287; padding-left: 6rpx; }
.stat-caption { color: #979b8b; font-size: 20rpx; margin-top: 16rpx; }
.budget-number { font-family: Georgia, serif; font-size: 36rpx; margin-top: 29rpx; overflow-wrap: anywhere; }
.budget-caption { color: #70825b; margin-top: 24rpx; }
.next-card { padding: 4rpx 32rpx; }
.next-task { display: flex; gap: 22rpx; align-items: center; padding: 27rpx 0; border-bottom: 1rpx solid #eeefe6; }
.next-task:last-child { border: 0; }
.task-content { flex: 1; min-width: 0; }
.task-title { font-size: 26rpx; line-height: 1.6; }
.task-meta { margin-top: 8rpx; color: #91987e; font-size: 21rpx; }
.meta-dot { margin: 0 13rpx; }
.task-chevron { color: #acb299; font-size: 32rpx; }
.journey { background: #f0f1e7; border-color: #e5e7d7; }
.journey-title { font-size: 30rpx; margin-top: 12rpx; }
.milestones { display: flex; margin-top: 30rpx; }
.milestone { flex: 1; position: relative; text-align: center; }
.milestone::before { content: ''; position: absolute; top: 23rpx; left: 50%; width: 100%; height: 1rpx; background: #d5dcc5; }
.milestone:last-child::before { display: none; }
.milestone-dot { margin: 0 auto; position: relative; z-index: 1; width: 46rpx; height: 46rpx; line-height: 44rpx; border: 1rpx solid #c6d0b2; background: #f0f1e7; border-radius: 50%; font-family: Georgia, serif; color: #84966b; }
.milestone-dot.complete { background: #7b916a; color: white; }
.milestone-title { font-size: 22rpx; margin-top: 18rpx; }
.milestone-count { font-size: 20rpx; color: #9aa487; margin-top: 5rpx; }
.journey-note { font-size: 20rpx; color: #929a80; text-align: center; margin-top: 24rpx; }
.hero { background: #f7efe4; border: 1rpx solid #ece1d3; color: #626b53; min-height: 330rpx; }
.hero-top { position: relative; font-family: Georgia, serif; font-style: italic; color: #af9f84; letter-spacing: 1rpx; font-size: 21rpx; }
.hero-illustration { position: absolute; width: 266rpx; height: 230rpx; right: 14rpx; bottom: 84rpx; }
.countdown-label { position: relative; color: #959b81; font-size: 23rpx; }
.countdown { position: relative; color: #778164; }
.day-unit { color: #a1a88e; }
.set-date { position: relative; color: #697357; font-size: 43rpx; margin-top: 36rpx; margin-bottom: 53rpx; }
.set-date text { color: #a8b08e; }
.hero-bottom { border-color: #e6dcc9; color: #9e9c81; font-size: 20rpx; }
.hero-edit { font-size: 19rpx; }
.stat-card { background: #fffdf7; }
.stat-card:first-child { background: #eef1e5; border-color: #e0e5d2; }
.stat-icon { width: 61rpx; height: 61rpx; margin: -9rpx -6rpx; }
.illustration-subtitle { font-size: 21rpx; color: #a2a68d; margin-top: 9rpx; }
.inspiration-grid { display: flex; flex-wrap: wrap; gap: 18rpx; }
.inspiration-card { width: calc((100% - 36rpx) / 3); padding: 26rpx 10rpx 24rpx; border: 1rpx solid #e1dfd1; border-radius: 24rpx; background: #fffdf7; }
.inspiration-card image { width: 115rpx; height: 115rpx; display: block; margin: 0 auto 11rpx; }
.inspiration-name { font-size: 24rpx; color: #7a866a; }
.inspiration-count { color: #a1a98f; font-size: 18rpx; margin-top: 8rpx; }
.journey { position: relative; }
.journey-illustration { position: absolute; right: 18rpx; top: 10rpx; width: 97rpx; height: 97rpx; opacity: .8; }
.journey-title { font-size: 28rpx; max-width: 80%; }
.milestone-art { display: block; width: 76rpx; height: 76rpx; margin: 0 auto; position: relative; z-index: 1; }
.milestone::before { top: 38rpx; }
