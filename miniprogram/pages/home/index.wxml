<view class="{{ready && pageVisible ? 'page-enter' : ''}} page">
  <view wx:if="{{syncEnabled}}" class="shared-sync-bar"><text class="{{syncError ? 'overdue' : ''}}">{{syncError || '共同计划 · 最近同步 ' + syncedAt}}</text><button class="text-link" bindtap="refresh" disabled="{{loading}}">刷新</button></view>
  <view wx:if="{{loading}}" class="loading-line">正在整理你们的计划…</view>
  <view wx:if="{{errorMessage}}" class="pressable notice error-notice" bindtap="refresh" hover-class="is-pressed" hover-start-time="20" hover-stay-time="100">{{errorMessage}} · 点此重试</view>
  <block wx:if="{{ready}}">
    <view class="enter-block between greeting">
      <view><view class="eyebrow">OUR WEDDING NOTES</view><view class="couple-name">{{profile.name1}} <text class="ampersand">&</text> {{profile.name2}}</view></view>
      <button class="pressable sync-pill" bindtap="openTogether" hover-class="is-pressed" hover-start-time="20" hover-stay-time="100"><text class="status-dot"></text>{{syncLabel}}</button>
    </view>
    <view class="enter-block pressable hero" bindtap="openTogether" hover-class="is-pressed" hover-start-time="20" hover-stay-time="100">
      <image class="hero-illustration" src="/assets/illustrations/wedding-hero.webp" mode="aspectFit" />
      <view class="hero-top">to our happily ever after</view>
      <view class="countdown-label">{{countdownLabel}}</view>
      <view wx:if="{{hasDate}}" class="countdown">{{countdown}}<text class="day-unit">天</text></view>
      <view wx:else class="set-date">定下好日子 <text>↗</text></view>
      <view class="hero-bottom"><text>{{dateLabel}}</text><text class="hero-edit">{{hasDate ? '调整日期' : '设置婚期'}} ›</text></view>
    </view>
    <view class="enter-block enter-later stat-grid">
      <view class="pressable card stat-card" bindtap="openTasks" hover-class="is-pressed" hover-start-time="20" hover-stay-time="100">
        <view class="between"><text class="stat-label">备婚进度</text><image class="stat-icon" src="/assets/illustrations/checklist.png" mode="aspectFit" /></view>
        <view class="stat-number">{{stats.progress}}<text>%</text></view>
        <view class="progress-track"><view class="progress-fill" style="width: {{stats.progress}}%;"></view></view>
        <view class="stat-caption">已完成 {{stats.done}} / {{stats.total}} 件小事</view>
      </view>
      <view class="pressable card stat-card" bindtap="openBudget" hover-class="is-pressed" hover-start-time="20" hover-stay-time="100">
        <view class="between"><text class="stat-label">婚礼预算</text><image class="stat-icon" src="/assets/illustrations/wallet.png" mode="aspectFit" /></view>
        <view class="budget-number">{{profile.totalBudget ? '¥' + stats.budgetText : '待商量'}}</view>
        <view class="stat-caption budget-caption">已付 ¥{{stats.paidText}}</view>
        <view class="stat-caption">{{stats.overBudget ? '预计开支已超预算' : '每一份心意，都有安排'}}</view>
      </view>
    </view>
    <view class="enter-block enter-last section">
      <view class="section-head"><view class="between category-heading"><text class="section-title">我们的备婚分类</text><button class="pressable text-link" bindtap="manageCategories" hover-class="is-pressed">管理分类 ›</button></view><view class="illustration-subtitle">把每个期待，收进喜欢的小抽屉。</view></view>
      <view class="inspiration-grid"><button wx:for="{{inspirations}}" wx:key="id" class="pressable inspiration-card" data-category="{{item.name}}" bindtap="openCategory" hover-class="is-pressed" hover-start-time="20" hover-stay-time="100"><image src="{{item.illustration}}" mode="aspectFit" /><view class="inspiration-copy"><view class="inspiration-name">{{item.name}}</view><view class="inspiration-count">{{item.count}} 件待准备 ↗</view></view></button></view>
      <button class="pressable category-add" bindtap="addCategory" hover-class="is-pressed">＋ 新增分类</button>
    </view>
    <view class="enter-block enter-last section">
      <view class="between section-head"><text class="section-title">接下来，一起做</text><button class="pressable text-link" bindtap="openTasks" hover-class="is-pressed" hover-start-time="20" hover-stay-time="100">查看清单 ›</button></view>
      <view class="card next-card">
        <view wx:for="{{upcoming}}" wx:key="id" class="pressable next-task" bindtap="openTasks" hover-class="is-pressed" hover-start-time="20" hover-stay-time="100">
          <button class="pressable checkbox task-check" data-id="{{item.id}}" catchtap="toggle" aria-label="完成{{item.title}}" hover-class="is-pressed" hover-start-time="20" hover-stay-time="100" hover-stop-propagation="{{true}}">✓</button>
          <view class="task-content"><view class="task-title">{{item.title}}</view><view class="task-meta"><text class="{{item.overdue ? 'overdue' : ''}}">{{item.dueLabel}}</text><text class="meta-dot">·</text><text>{{item.owner}}</text></view></view>
          <text class="task-chevron">›</text>
        </view>
        <view wx:if="{{!upcoming.length}}" class="empty"><view class="empty-title">准备好的，都是幸福</view><view class="empty-copy">清单已完成，给彼此一个拥抱吧。</view><button class="pressable text-link" bindtap="openTasks" hover-class="is-pressed" hover-start-time="20" hover-stay-time="100">再记一件小事 ›</button></view>
      </view>
    </view>
    <view wx:if="{{paymentReminderCount}}" class="enter-block enter-last section card payment-list">
      <view class="between section-head"><text class="section-title">别忘了这几笔心意</text><button class="text-link" bindtap="openBudget">预算 ›</button></view>
      <button wx:for="{{paymentReminders}}" wx:key="id" class="pressable payment-row" data-id="{{item.id}}" bindtap="openPayment" hover-class="is-pressed"><view>{{item.title}} · 待付 ¥{{item.outstandingText}}</view><view class="reminder-meta {{item.paymentOverdue ? 'overdue' : ''}}">{{item.paymentDueDate}} · {{item.paymentLabel}} ›</view><view wx:if="{{item.taskTitle}}" class="reminder-meta">{{item.taskTitle}}</view></button>
      <view class="field-hint">共 {{paymentReminderCount}} 笔付款提醒 · 打开应用时更新</view>
    </view>
    <view class="enter-block enter-last section journey card">
      <image class="journey-illustration" src="/assets/illustrations/plant.png" mode="aspectFit" />
      <view class="eyebrow">ONE STEP AT A TIME</view><view class="journey-title">把期待，一点点变成现实</view>
      <view class="milestones"><view wx:for="{{stages}}" wx:key="title" class="milestone"><image class="milestone-art" src="{{item.illustration}}" mode="aspectFit" /><view class="milestone-title">{{item.done ? '✓ ' : ''}}{{item.title}}</view><view class="milestone-count">{{item.count}} / {{item.total}}</view></view></view>
      <view class="journey-note">默认清单的准备阶段 · 按自己的节奏慢慢来</view>
    </view>
    <view class="footer-note">婚礼是一天，我们是每一天。</view>
  </block>
</view>
<bottom-sheet visible="{{categoryEditor}}" busy="{{saving}}" title="{{categoryMode === 'list' ? '管理备婚分类' : editingCategoryId ? '编辑分类' : '新增分类'}}" bindclose="closeCategories">
  <block wx:if="{{categoryMode === 'list'}}">
    <view class="field-hint category-manager-hint">按你们的习惯命名，也可以换个喜欢的图标。清单和预算会一起更新。</view>
    <button wx:for="{{inspirations}}" wx:key="id" class="pressable category-manage-row" data-id="{{item.id}}" bindtap="editCategory" hover-class="is-pressed"><image src="{{item.illustration}}" mode="aspectFit" /><view class="category-manage-copy"><view>{{item.name}}</view><view class="field-hint">{{item.taskCount}} 件事项 · {{item.expenseCount}} 笔开支</view></view><text class="muted">编辑 ›</text></button>
    <button class="pressable category-add" bindtap="addCategory" hover-class="is-pressed">＋ 新增分类</button>
    <view class="field-hint">{{inspirations.length}} / 24 个分类</view>
  </block>
  <block wx:else>
    <button class="text-link category-back" bindtap="backToCategories" disabled="{{saving}}">‹ 返回分类列表</button>
    <view class="field"><text class="field-label">分类名称</text><input class="field-input" value="{{categoryForm.name}}" bindinput="categoryName" maxlength="12" placeholder="比如：蜜月旅行、婚车接送" disabled="{{saving}}" /></view>
    <view class="field"><text class="field-label">选一个喜欢的图标</text><view class="category-icon-grid"><button wx:for="{{icons}}" wx:key="id" class="pressable category-icon-option {{categoryForm.icon === item.id ? 'selected' : ''}}" data-icon="{{item.id}}" bindtap="chooseCategoryIcon" disabled="{{saving}}" hover-class="is-pressed" aria-label="{{item.title}}{{categoryForm.icon === item.id ? '，已选择' : ''}}"><image src="{{item.illustration}}" mode="aspectFit" /><text>{{item.title}}</text><text wx:if="{{categoryForm.icon === item.id}}" class="category-icon-check">✓</text></button></view></view>
    <view wx:if="{{categoryError}}" class="notice error-notice">{{categoryError}}</view>
    <view wx:if="{{editingCategoryId}}" class="field-hint category-manager-hint">改名和更换图标会同步到此分类的清单与预算。需先移走所有事项和开支，才能删除分类；至少保留一个分类。</view>
    <button class="pressable primary category-save" bindtap="saveCategory" disabled="{{saving}}" loading="{{saving}}" hover-class="is-pressed">保存分类</button>
    <button wx:if="{{canDeleteCategory}}" class="pressable danger-link" bindtap="removeCategory" disabled="{{saving}}" hover-class="is-pressed">删除空分类</button>
  </block>
</bottom-sheet>
